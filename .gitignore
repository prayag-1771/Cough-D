# Corpora and everything derived from them. These are redistributable only
# from their own sources, and the image sets run to tens of thousands of files.
# Every one of them is reproducible from the ingest scripts in code/.
data/

# Selected network weights. Roughly 45 MB per run. The second grid keeps its
# own directory because both grids name a run by architecture, condition and
# seed, so one directory would have the second corpus overwrite the first.
weights/
weights_coughvid/

# Decoded image caches written beside the image sets.
*.npz

# Runs made under the superseded training protocol, kept locally only so the
# change of protocol can be re-examined. They are not the results reported.
runs_old_protocol/

# Runs made at the batch size that overran the card, kept locally only so the
# measurement can be re-examined. They are not the results reported.
runs_old_batch64/

# Job output. Transient, and full of absolute paths from this machine.
logs/

# The source assignment this work extends. It is another author's document and
# is not ours to redistribute.
*.pdf

# The manuscript's own figures are generated by figures.py and are needed to
# build it, so they are kept despite the rule above.
!manuscript/figs/*.pdf

# The IEEE Access class, IEEEtran, and the licensed fonts and journal logos
# the class loads. These are the publisher's to distribute and not ours.
# code/fetch_ieee_class.py installs all of them from IEEE's own archive, so a
# clone is one command away from being able to build the Access target.
manuscript/ieeeaccess.cls
manuscript/IEEEtran.cls
manuscript/spotcolor.sty
manuscript/*.fd
manuscript/*.map
manuscript/*.tfm
manuscript/*.pfb
manuscript/logo.png
manuscript/notaglinelogo.png
manuscript/bullet.png

__pycache__/
*.pyc

# LaTeX build products.
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.lof
*.log
*.lot
*.out
*.synctex.gz
*.toc

# Editor backups.
*.bak

# MATLAB listing lifted from the source assignment. Another author's code.
code_extracted.txt
